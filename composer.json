{
	"name": "limegreentangerine/eventbrite",
	"description": "Eventbrite package",
	"type": "concrete5-package",
	"license": "proprietary",
	"minimum-stability": "stable",
	"autoload": {
		"psr-4": {
			"Eventbrite\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Eventbrite\\Tests\\": "tests/"
		}
	},
	"authors": [
		{
			"name": "Dave Hendy",
			"email": "david@limegreentangerine.co.uk"
		}
	],
	"require-dev": {
		"php": "^8.4",
		"phpunit/phpunit": "^11",
		"concrete5/core": "^9.2",
		"friendsofphp/php-cs-fixer": "^3.95"
	},
	"config": {
		"allow-plugins": {
			"mlocati/composer-patcher": true
		}
	},
	"scripts": {
		"test": "phpunit",
		"test-coverage": "phpunit --coverage-text",
		"format:php": "php-cs-fixer fix",
		"format:php:check": "php-cs-fixer check --diff",
		"format:js": "npx prettier --write .",
		"format:js:check": "npx prettier --check .",
		"format": [
			"@format:php",
			"@format:js"
		],
		"format:check": [
			"@format:php:check",
			"@format:js:check"
		],
		"post-install-cmd": [
			"npm install"
		]
	},
	"require": {
		"limegreentangerine/class_kit": "^1.0",
		"limegreentangerine/lgt_toolkit": "^0.0.0"
	},
	"repositories": [
		{
			"type": "composer",
			"url": "https://packages.limegreentangerine.net"
		}
	]
}
